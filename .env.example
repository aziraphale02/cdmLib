# Port configuration for Express server
PORT=5002

# Secret key for JWT signing. Replace this with a secure random string in production.
JWT_SECRET=your_secure_random_hex_key_here

# Allowed origins for CORS (comma-separated list of deployed frontend URLs)
ALLOWED_ORIGINS=https://your-frontend-app.onrender.com,https://your-app.vercel.app
FRONTEND_URL=https://your-frontend-app.onrender.com

# Target API URL for frontend production build / Vite proxy
VITE_API_BASE_URL=https://your-backend-api.onrender.com

