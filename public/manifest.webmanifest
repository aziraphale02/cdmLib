{
  "name": "Colegio de Montalban - Library Portal",
  "short_name": "CDM Library",
  "description": "Official Student Mobile Companion & OPAC for Colegio de Montalban Integrated Library Management System.",
  "start_url": "/mobile",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#064e3b",
  "theme_color": "#047857",
  "categories": ["education", "books", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Catalog",
      "short_name": "Catalog",
      "description": "Explore 76+ curated academic volumes across ICS, ITE, and IBE",
      "url": "/mobile?tab=books",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Digital Pass & QR",
      "short_name": "Pass",
      "description": "Open your ISO/IEC 18004 dynamic student accession card",
      "url": "/mobile?tab=pass",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Active Loans & Holds",
      "short_name": "Loans",
      "description": "Check borrowed titles, reservations and due dates",
      "url": "/mobile?tab=profile",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
